{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flint launcher.yaml",
  "description": "0.1 compatibility and 0.2 project contract. Runtime checker also verifies cwd and current platform.",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s*$)(?!.*\\$\\{)[^\\u0000\\r\\n]+$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[^$\\u0000]|\\$(?!\\{)|\\$\\{(?:port|host|dataDir|cacheDir)\\})*$"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?![Ll][Aa][Uu][Nn][Cc][Hh][Ee][Rr]_)[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:[^$\\u0000]|\\$(?!\\{)|\\$\\{(?:port|host|dataDir|cacheDir)\\})*$"
          }
        }
      },
      "required": [
        "program"
      ]
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "existing"
            }
          },
          "required": [
            "mode"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "default": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                }
              },
              "required": [
                "default"
              ]
            }
          },
          "required": [
            "port"
          ]
        },
        "category": {
          "const": "service"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "enum": [
                "http-api",
                "mcp-http"
              ]
            },
            "cwd": {
              "type": "string"
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "healthPath": {
              "type": "string",
              "pattern": "^$|^/(?!/)[^\\r\\n\\\\#]*$"
            }
          },
          "required": [
            "protocol",
            "cwd",
            "command",
            "healthPath"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "environment",
        "parameters",
        "category",
        "service"
      ]
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.2"
        },
        "id": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "existing"
            }
          },
          "required": [
            "mode"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "default": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                }
              },
              "required": [
                "default"
              ]
            }
          },
          "required": [
            "port"
          ]
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "macos",
              "linux",
              "windows"
            ]
          }
        },
        "install": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "enum": [
                "http-api",
                "mcp-http"
              ]
            },
            "cwd": {
              "type": "string",
              "default": "."
            },
            "run": {
              "$ref": "#/$defs/command"
            },
            "healthPath": {
              "type": "string",
              "pattern": "^$|^/(?!/)[^\\r\\n\\\\#]*$"
            }
          },
          "required": [
            "protocol",
            "run"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "protocol": {
                    "const": "mcp-http"
                  }
                }
              },
              "then": {
                "required": [
                  "healthPath"
                ],
                "properties": {
                  "healthPath": {
                    "type": "string",
                    "pattern": "^$|^/(?!/)[^\\r\\n\\\\#]*$",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "name",
        "environment",
        "parameters",
        "service"
      ]
    }
  }
}
